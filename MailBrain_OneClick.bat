@echo off
setlocal
set "MB_SELF=%~f0"
set "MB_DEST=%LOCALAPPDATA%\MailBrain"
set "MB_MARKER=%LOCALAPPDATA%\MailBrain\.oneclick-build"
set "MB_HASH=DDD1A32FA56D7948F169BB0F2D8A066F7178DA4DE22BD3C6483F2FFB3F1C1984"

if exist "%MB_MARKER%" (
    findstr /x /c:"%MB_HASH%" "%MB_MARKER%" >nul
    if not errorlevel 1 goto LAUNCH
)

echo Extracting Mail Brain to your local app folder...
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $lines=[IO.File]::ReadAllLines($env:MB_SELF); $begin=[Array]::IndexOf($lines,'::PAYLOAD_BEGIN'); $end=[Array]::IndexOf($lines,'::PAYLOAD_END'); if ($begin -lt 0 -or $end -le $begin+1) { throw 'Installer payload is missing.' }; $b64=[string]::Join('', $lines[($begin+1)..($end-1)]); $bytes=[Convert]::FromBase64String($b64); $zip=Join-Path $env:TEMP ('MailBrain-'+[guid]::NewGuid().ToString('N')+'.zip'); [IO.File]::WriteAllBytes($zip,$bytes); try { $actual=(Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash; if ($actual -ne $env:MB_HASH) { throw 'Installer integrity check failed.' }; New-Item -ItemType Directory -Force -Path $env:MB_DEST | Out-Null; Expand-Archive -LiteralPath $zip -DestinationPath $env:MB_DEST -Force; Set-Content -LiteralPath $env:MB_MARKER -Value $env:MB_HASH -Encoding ASCII } finally { Remove-Item -LiteralPath $zip -Force -ErrorAction SilentlyContinue }"
if errorlevel 1 goto INSTALL_FAILED

:LAUNCH
if not exist "%MB_DEST%\setup.bat" goto INSTALL_FAILED
set "SETUP_NOPAUSE=1"
call "%MB_DEST%\setup.bat"
if errorlevel 1 goto INSTALL_FAILED
if not exist "%MB_DEST%\config.json" copy "%MB_DEST%\config.example.json" "%MB_DEST%\config.json" >nul
pushd "%MB_DEST%"
call run.bat
popd
exit /b 0

:INSTALL_FAILED
echo Installation or launch failed. Check internet access, winget, and the error above.
pause
exit /b 1

goto :EOF
